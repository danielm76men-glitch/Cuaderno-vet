rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAllowedUser() {
      return request.auth != null
        && request.auth.token.email in ['danielm76men@gmail.com', 'daniel.mendoza@ute.edu.ec'];
    }

    // El perfil del veterinario vive dentro de "entries" con
    // section: "profile", asi que estas mismas reglas ya lo cubren.
    // No hace falta publicar nada nuevo para que el perfil funcione.
    match /entries/{entryId} {
      allow read, update, delete: if isAllowedUser() && request.auth.uid == resource.data.uid;
      allow create: if isAllowedUser() && request.auth.uid == request.resource.data.uid;
    }

    match /formulario/{formularioId} {
      allow read, update, delete: if isAllowedUser() && request.auth.uid == resource.data.uid;
      allow create: if isAllowedUser() && request.auth.uid == request.resource.data.uid;
    }

    // Las fotos de los casos. Van en coleccion propia y no dentro de
    // "entries" a proposito: asi el listener global no arrastra las fotos de
    // todos los casos, y cada ficha pide solo las suyas al abrirse.
    // Mismo criterio de acceso que el resto: tu correo y tu uid.
    match /fotos/{fotoId} {
      allow read, update, delete: if isAllowedUser() && request.auth.uid == resource.data.uid;
      allow create: if isAllowedUser() && request.auth.uid == request.resource.data.uid;
    }
  }
}
